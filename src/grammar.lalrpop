use std::str::FromStr;
use crate::ast::{Expr, UnaryOp, BinaryOp};

grammar;

pub Program: Vec<Expr> = {
    <v:FuncDef*> => v,
}

FuncDef: Expr = {
    "fn" <name:Identifier> "(" <params:Comma<Identifier>> ")" "{" <body:Expr> "}" => 
        Expr::FuncDef(name, params, Box::new(body)),
}

Expr: Expr = {
    Let,
    If,
    BinExpr,
}

Let: Expr = {
    "let" <bindings:Comma<LetBinding>> "in" <body:Expr> => 
        Expr::Let(bindings, Box::new(body)),
}

LetBinding: (String, Box<Expr>) = {
    <id:Identifier> "=" <e:BinExpr> => (id, Box::new(e)),
}

If: Expr = {
    "if" <cond:BinExpr> "{" <then:Expr> "}" "else" "{" <else_:Expr> "}" => 
        Expr::If(Box::new(cond), Box::new(then), Box::new(else_)),
}

BinExpr: Expr = {
    <l:BinExpr> "+" <r:Factor> => Expr::BinOp(BinaryOp::Add, Box::new(l), Box::new(r)),
    <l:BinExpr> "-" <r:Factor> => Expr::BinOp(BinaryOp::Sub, Box::new(l), Box::new(r)),
    <l:BinExpr> "==" <r:Factor> => Expr::BinOp(BinaryOp::Eq, Box::new(l), Box::new(r)),
    <l:BinExpr> "<" <r:Factor> => Expr::BinOp(BinaryOp::Lt, Box::new(l), Box::new(r)),
    Factor,
}

Factor: Expr = {
    Num,
    "(" <e:Expr> ")" => e,
    FuncCall,
    Identifier => Expr::Id(<>),
    UnaryExpr,
}

FuncCall: Expr = {
    <func:Identifier> "(" <args:Comma<Expr>> ")" => 
        Expr::FuncCall(Box::new(Expr::Id(func)), args.into_iter().map(Box::new).collect()),
}

UnaryExpr: Expr = {
    "add1" <e:Factor> => Expr::UnOp(UnaryOp::Add1, Box::new(e)),
    "sub1" <e:Factor> => Expr::UnOp(UnaryOp::Sub1, Box::new(e)),
    "isZero" <e:Factor> => Expr::UnOp(UnaryOp::IsZero, Box::new(e)),
    "isNum" <e:Factor> => Expr::UnOp(UnaryOp::IsNum, Box::new(e)),
    "!" <e:Factor> => Expr::UnOp(UnaryOp::Not, Box::new(e)),
}

Num: Expr = {
    r"-?[0-9]+" => Expr::Num(i64::from_str(<>).unwrap()),
}

Identifier: String = {
    r"[a-zA-Z_][a-zA-Z0-9_]*" => <>.to_string(),
}

Comma<T>: Vec<T> = {
    <v:(<T> ",")*> <e:T?> => match e {
        None => v,
        Some(e) => {
            let mut v = v;
            v.push(e);
            v
        }
    }
}